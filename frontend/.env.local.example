# Frontend Environment Variables (Development)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws/interview
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
NEXT_PUBLIC_AI_API_KEY=your-openai-api-key
NEXT_PUBLIC_AI_API_URL=https://api.openai.com/v1/chat/completions
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_SENTRY_DSN=

# Frontend Environment Variables (Production)
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_WS_URL=wss://your-domain.com
# NEXT_PUBLIC_RAZORPAY_KEY_ID=your_production_razorpay_key_id
# NEXT_PUBLIC_AI_API_KEY=your_production_openai_api_key
# NEXT_PUBLIC_AI_API_URL=https://api.openai.com/v1/chat/completions
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn