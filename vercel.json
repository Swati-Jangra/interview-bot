{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "regions": ["iad1"],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/dist/api/$1"
    },
    {
      "src": "/ws/(.*)",
      "dest": "backend/dist/ws/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
